{
  "apps": [
    {
      "name": "RAG",
      "cwd": "./",
      "script": "./bin/www",
      "interpreter": "node",
      "treekill": false,
      "watch": true,
      "watch_delay": 1000,
      "ignore_watch": [
        "node_modules",
        "**/node_modules/**",
        ".rag-cache",
        "**/.rag-cache/**",
        "**/*.log",
        ".git",
        "/public/pdf"
      ],
      "watch_options": {
        "followSymlinks": false,
        "usePolling": true,
        "interval": 1000
      }
    }
  ]
}
